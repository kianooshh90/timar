generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (pgbouncer, port 6543) — used at runtime
  directUrl = env("DIRECT_URL")   // direct connection (port 5432) — used for migrations only
}

// ============ Users & Auth ============
model User {
  id           String       @id @default(cuid())
  email        String       @unique
  password     String // bcrypt hash
  name         String
  role         String       @default("LAB") // ADMIN | LAB | DESIGNER
  username     String?      @unique // designers log in with this (chosen by the admin)
  active       Boolean      @default(true) // disabled accounts cannot log in
  labName      String?
  phone        String?
  city         String?
  // Customer-club infrastructure (feature ships later)
  points       Int          @default(0)
  referralCode String?      @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  cases        Case[]       @relation("CaseLab") // cases submitted by this lab
  designed     Case[]       @relation("CaseDesigner") // cases assigned to this designer
}

// ============ Portfolio (Case Vault) ============
model PortfolioItem {
  id           String   @id @default(cuid())
  title        String
  titleEn      String?
  description  String
  descriptionEn String?
  category     String // IMPLANTS | CROWN_BRIDGE | REMOVABLE | DSD | FULL_ARCH
  badge        String? // e.g. ZIRCONIA / IMPLANT / DSD
  images       String   @default("[]") // JSON array of image paths
  files        String   @default("[]") // JSON array of {path,name,size}
  published    Boolean  @default(true)
  sortOrder    Int      @default(0)
  views        Int      @default(0)
  downloads    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============ Services & Pricing (Toman) ============
model Service {
  id         String  @id @default(cuid())
  category   String // CROWN_BRIDGE | IMPLANT | REMOVABLE | FULL_ARCH | DSD
  name       String
  nameEn     String
  price      Float // Toman
  unit       String  @default("/unit") // /unit | /arch | /case
  turnaround String  @default("۱ تا ۲ ساعت")
  active     Boolean @default(true)
  sortOrder  Int     @default(0)
}

// ============ Editable site content ============
model SiteSetting {
  key   String @id
  value String // JSON-encoded
}

// ============ Lab cases ============
model Case {
  id            String        @id @default(cuid())
  code          String        @unique // TDC-1042
  userId        String
  user          User          @relation("CaseLab", fields: [userId], references: [id])
  patientName   String?
  toothNumbers  String?
  serviceType   String // CROWN_BRIDGE | IMPLANT | REMOVABLE | FULL_ARCH | DSD
  notes         String?
  status        String        @default("RECEIVED") // RECEIVED | IN_DESIGN | QC | DELIVERED | CANCELLED
  adminNote     String?
  price         Float?
  files         String        @default("[]") // JSON [{path,name,size}]
  deliveryFiles String        @default("[]") // JSON [{path,name,size}]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  messages      CaseMessage[]

  // --- designer workflow ---
  designerId    String?
  designer      User?         @relation("CaseDesigner", fields: [designerId], references: [id], onDelete: SetNull)
  assignedAt    DateTime?
  dueAt         DateTime? // deadline set by the admin when assigning
  designerNote  String? // instructions from admin to designer
  submittedAt   DateTime? // when the designer sent the work for review
  deliveredAt   DateTime?
  revisionCount Int           @default(0) // times the work was sent back (by admin or lab)
  rating        Int? // lab / doctor satisfaction 1..5
  ratingComment String?
  ratedAt       DateTime?
  score         Int? // admin's score for the designer on this case, 0..100
  scoreNote     String?
  scoredAt      DateTime?
  events        CaseEvent[]

  @@index([designerId])
}

/// Activity log of a case: assignment, submission, revisions, rating, score and internal notes
model CaseEvent {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type      String // ASSIGNED | UNASSIGNED | STARTED | SUBMITTED | REVISION | DELIVERED | RATED | SCORED | NOTE | STATUS
  note      String?
  actorId   String?
  actorRole String? // ADMIN | DESIGNER | LAB
  actorName String?
  createdAt DateTime @default(now())

  @@index([caseId])
}

model CaseMessage {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  fromAdmin Boolean  @default(false)
  body      String
  createdAt DateTime @default(now())
}

// ============ Public inquiries (Talk To Us) ============
model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  topic     String   @default("GENERAL")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============ Rate-card / newsletter subscribers ============
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
